# CareerHunt Environment Configuration Template
# Copy this file to .env and customize for your local environment

# Security
SECRET_KEY=django-insecure-careerhunt-dev-key-change-in-production-!#98xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/careerhunt_db

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/

# Data Collector Settings
COLLECTOR_USER_AGENT=CareerHuntBot/1.0 (+https://careerhunt.local/bot-info)
COLLECTOR_REQUEST_TIMEOUT=15
COLLECTOR_MAX_RETRIES=3

# Optional Email / Notification Service
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=CareerHunt <no-reply@careerhunt.local>
